<Page x:Class="UP01_Prokofev_Bank.Pages.AccountTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP01_Prokofev_Bank.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Таблица счетов"
      FontFamily="{DynamicResource MainFont}"
      Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="DataGridAccount" Margin="5"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер счёта" Binding="{Binding Number}" Width="2*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Users.FIO}" Width="2*"/>
                <DataGridTextColumn Header="Отделение" Binding="{Binding Branch.Name}" Width="2*"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Balance, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Дата открытия" Binding="{Binding OpenDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" x:Name="ButtonAdd" ToolTip="Добавить данные" Content="Добавить"
                HorizontalAlignment="Left" Click="ButtonAdd_Click"/>
        <Button Grid.Row="1" x:Name="ButtonDel" ToolTip="Удалить выбранные записи" Content="Удалить"
                HorizontalAlignment="Right" Click="ButtonDel_Click"/>
    </Grid>
</Page>
