<Page x:Class="UP01_Prokofev_Bank.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP01_Prokofev_Bank.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация"
      FontFamily="{DynamicResource MainFont}"
      Foreground="{DynamicResource TextBrush}">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label x:Name="labelLogin" Grid.Row="0" Grid.Column="0" Content="Логин" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1" Margin="5" MaxLength="50"
                 ToolTip="Введите логин"
                 TextChanged="TextBoxLogin_TextChanged"
                 PreviewTextInput="TextBoxLogin_PreviewTextInput"
                 PreviewKeyDown="TextBoxLogin_PreviewKeyDown"/>
        <Label x:Name="txtHintLogin" Grid.Row="0" Grid.Column="1" Margin="5" Content="Введите логин"
               Style="{DynamicResource HintStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
               MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>

        <Label x:Name="labelPass" Grid.Row="1" Grid.Column="0" Content="Пароль" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="5"
                     ToolTip="Введите пароль"
                     PasswordChanged="PasswordBox_PasswordChanged"/>
        <Label x:Name="txtHintPass" Grid.Row="1" Grid.Column="1" Margin="5" Content="Введите пароль"
               Style="{DynamicResource HintStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
               MouseLeftButtonUp="txtHintPass_MouseLeftButtonUp"/>

        <!-- Сам текст капчи -->
        <Label Content="Капча:" Name="labelCaptcha" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Visibility="Hidden"/>
        <TextBox x:Name="captcha" Grid.Row="0" Grid.Column="1" Margin="5"
                 Style="{DynamicResource CaptchaStyle}"
                 CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                 ContextMenu="{x:Null}"
                 IsReadOnly="True"
                 HorizontalContentAlignment="Center"
                 ToolTip="Символы, которые нужно ввести"
                 Visibility="Hidden"/>

        <!-- Поле для ввода -->
        <TextBox x:Name="captchaInput" Grid.Row="1" Grid.Column="1" Margin="5" MaxLength="6"
                 CommandManager.PreviewExecuted="textBox_PreviewExecuted"
                 ContextMenu="{x:Null}"
                 ToolTip="Введите символы капчи вручную"
                 TextChanged="captchaInput_TextChanged"
                 Visibility="Hidden"/>
        <Label x:Name="txtHintCaptcha" Grid.Row="1" Grid.Column="1" Margin="5" Content="Введите капчу"
               Style="{DynamicResource HintStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
               MouseLeftButtonUp="txtHintCaptcha_MouseLeftButtonUp"
               Visibility="Hidden"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="ButtonEnter" Content="Вход" ToolTip="Войти в систему" Click="ButtonEnter_OnClick"/>
            <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Перейти к регистрации" Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля" ToolTip="Перейти к смене пароля"
                    Click="ButtonChangePassword_Click"/>
        </StackPanel>

        <!-- Кнопка подтверждения -->
        <Button x:Name="submitCaptcha" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,15,5,5"
                Content="Подтвердить" ToolTip="Подтвердить ввод капчи"
                Click="submitCaptcha_Click"
                Visibility="Hidden"/>
    </Grid>
</Page>
